export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed" });
  }

  const { symptomText, history = {} } = req.body;

  if (!symptomText || typeof symptomText !== "string") {
    return res.status(400).json({ error: "symptomText is required" });
  }

  const prompt = `You are a clinical intake assistant, not a doctor.

The patient's current complaint or response is:
"${symptomText}"

Previous information collected:
${JSON.stringify(history)}

Continue collecting the patient's clinical history.

Respond ONLY with JSON in this exact format, nothing else:
{
  "chiefComplaint": "short category name",
  "followUpQuestions": [
    { "question": "a relevant clarifying yes/no question", "key": "shortKeyName" },
    { "question": "another relevant clarifying yes/no question", "key": "shortKeyName2" }
  ]
}

Rules:
- Never diagnose.
- Never suggest treatment.
- Ask only relevant clinical history questions.
- Use the previous information so you do not repeat questions.
- Adapt questions to the patient's actual complaint.
- Do not assume a specific disease or symptom.
- Provide 1 to 3 relevant follow-up questions maximum.
- If enough information has been collected, return an empty followUpQuestions array.
`;

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${process.env.GEMINI_API_KEY}`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          contents: [
            {
              parts: [{ text: prompt }],
            },
          ],
        }),
      }
    );

    if (!response.ok) {
      throw new Error(`Gemini API error: ${response.status}`);
    }

    const data = await response.json();

    const rawText =
      data?.candidates?.[0]?.content?.parts?.[0]?.text;

    if (!rawText) {
      throw new Error("Gemini returned no text");
    }

    const cleaned = rawText
      .replace(/```json/g, "")
      .replace(/```/g, "")
      .trim();

    const parsed = JSON.parse(cleaned);

    return res.status(200).json(parsed);
  } catch (err) {
    console.error("Adaptive question error:", err);

    return res.status(500).json({
      error: "Failed to process symptom",
    });
  }
}
````
