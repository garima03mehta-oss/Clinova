export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed" });
  }

  const { symptomText } = req.body;

  const prompt = `You are a clinical intake assistant, not a doctor. A patient described this complaint: "${symptomText}".

Respond ONLY with JSON in this exact format, nothing else:
{
  "chiefComplaint": "short category name, e.g. chest pain, leg pain, blackout",
  "followUpQuestions": [
    { "question": "a clarifying yes/no question", "key": "shortKeyName" },
    { "question": "another clarifying yes/no question", "key": "shortKeyName2" }
  ]
}

Rules: never diagnose, never suggest treatment, only ask clarifying clinical history questions a nurse would ask during intake. Provide 2 to 3 follow-up questions maximum.`;

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${process.env.GEMINI_API_KEY}`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
      }
    );

    const data = await response.json();
    const rawText = data.candidates[0].content.parts[0].text;
    const cleaned = rawText.replace(/```json|```/g, "").trim();
    const parsed = JSON.parse(cleaned);

    res.status(200).json(parsed);
  } catch (err) {
    res.status(500).json({ error: "Failed to process symptom" });
  }
}